# ─── FRIDAY AI — Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values

# ── LLM API Keys ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Voice ─────────────────────────────────────────────────────────────────
PICOVOICE_ACCESS_KEY=your_picovoice_key_here   # Wake word detection
WAKE_WORD=friday                                 # Say "Friday" to wake
TTS_VOICE=en-US-AriaNeural                       # Edge TTS voice (neural)
TTS_RATE=+15%                                    # Speech rate
TTS_PITCH=+5Hz                                   # Slightly higher pitch

# ── Owner ─────────────────────────────────────────────────────────────────
OWNER_NAME=Boss
OWNER_PHONE=+91XXXXXXXXXX                        # Your WhatsApp number
OWNER_EMAIL=your@email.com

# ── System ────────────────────────────────────────────────────────────────
FRIDAY_HOME=C:/Users/chira/OneDrive/Desktop/friday
MEMORY_DB_PATH=./data/memory.db
VECTOR_DB_PATH=./data/chromadb
LOG_PATH=./logs/friday.log

# ── WhatsApp ──────────────────────────────────────────────────────────────
WHATSAPP_PHONE=+91XXXXXXXXXX
CHROME_PROFILE_PATH=C:/Users/chira/AppData/Local/Google/Chrome/User Data

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=8765
DASHBOARD_SECRET=change_this_secret

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_ADDRESS=your@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Proactive Mode ────────────────────────────────────────────────────────
PROACTIVE_CHECK_INTERVAL=300    # seconds between boredom checks
IDLE_THRESHOLD_MINUTES=15       # minutes of inactivity = bored
